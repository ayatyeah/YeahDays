# Скопируй в .env и заполни (значения — в Railway → Postgres → Variables).

# Локально используй ПУБЛИЧНЫЙ URL (DATABASE_PUBLIC_URL из Railway,
# хост *.proxy.rlwy.net). На Railway веб-сервис берёт внутренний
# DATABASE_URL (postgres.railway.internal) автоматически.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB"

# local  — весь скоринг в браузере (офлайн, без БД)
# remote — рекомендации и события через /api + Postgres
NEXT_PUBLIC_ENGINE="remote"

# ── Auth.js (Google) ──
# AUTH_SECRET: сгенерируй `npx auth secret` или `openssl rand -base64 33`
AUTH_SECRET=""
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web):
#   Authorized redirect URIs:
#     http://localhost:3000/api/auth/callback/google
#     https://ТВОЙ-домен.up.railway.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# На проде (Railway) обязательно задать точный адрес сайта, иначе Auth.js
# соберёт redirect_uri неправильно и Google вернёт redirect_uri_mismatch:
# AUTH_URL="https://ТВОЙ-домен.up.railway.app"

# ── Push-уведомления (Web Push) ──
# Сгенерировать пару: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT="mailto:you@example.com"
# Защита эндпоинта рассылки /api/push/send — без него его мог бы
# дёрнуть кто угодно. Крон должен слать заголовок:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ── Синхронизация календаря LMS (AITU Moodle) ──
# Постоянная ссылка на ical-экспорт календаря: в LMS открой
#   Calendar → Export calendar → All events + Custom range
# и нажми "Get calendar URL" (не "Export" — та скачивает файл разово).
#
# ВНИМАНИЕ: в ссылке зашит authtoken — постоянный ключ к календарю
# пользователя, в Moodle он не отзывается в один клик. Обращаться как с
# паролем: только в переменных окружения, никогда в репозитории.
#
# Почему ссылка, а не API Moodle: веб-сервисы в AITU закрыты на nginx
# (/login/token.php и /webservice/rest/server.php отдают 403), живым
# остался только штатный ical-экспорт.
LMS_ICAL_URL=""
# Чей аккаунт наполняем — id пользователя YeahGrind.
LMS_SYNC_USER_ID=""
# Зона, в которой считаются дни дедлайнов. По умолчанию Asia/Almaty.
LMS_TIMEZONE=""

# ── Владельческая консоль (/admin) ──
# Единственный email, которому доступна /admin (список юзеров, смена
# паролей, заявки с /forgot-password).
OWNER_EMAIL=""

# ── Аналитика и мониторинг (опционально) ──
# Пока не заданы — обёртки молчат, приложение работает как обычно.
NEXT_PUBLIC_ANALYTICS_URL=""
NEXT_PUBLIC_SENTRY_DSN=""
