# OpenAI — единственный обязательный внешний ключ.
OPENAI_API_KEY=

# Модели можно не трогать — значения по умолчанию актуальны на момент сборки.
# OPENAI_CHAT_MODEL=gpt-5.5
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Кодовое слово "Джарвис" ищется распознаванием речи (Whisper понимает
# русский) — не локальным классификатором: ни Picovoice, ни openWakeWord
# не умеют обучать русские слова.

# Сколько минут тишины после ответа ДиДи ещё держит контекст разговора
# (следующая фраза не требует повторного "Джарвис"). См. README.
# MEMORY_WINDOW_MINUTES=5

# YeahGrind: где крутится приложение и твой userId из localStorage["yd-uid"]
# (открой приложение в браузере → DevTools → Console → localStorage.getItem("yd-uid")).
YEAHGRIND_BASE_URL=http://localhost:3000
YEAHGRIND_USER_ID=
# Должен СОВПАДАТЬ с ASSISTANT_SECRET в .env корня репозитория YeahGrind.
ASSISTANT_SECRET=

# -1 — микрофон по умолчанию. Список устройств: npx tsx scripts/list-devices.ts
# AUDIO_DEVICE_INDEX=-1

# Куда писать журнал выполненных команд/файловых операций (для аудита).
# DIDI_LOG_FILE=didi-actions.log
