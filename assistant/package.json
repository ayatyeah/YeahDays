{
  "name": "didi-assistant",
  "version": "0.4.17",
  "private": true,
  "description": "ДиДи — голосовой помощник на OpenAI, отдельное desktop-приложение (Electron): кодовое слово через распознавание речи, управление ноутом, задачи и настроение YeahGrind через общую БД.",
  "type": "module",
  "main": "./out/main/index.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "devices": "tsx scripts/list-devices.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@picovoice/pvrecorder-node": "^1.2.4",
    "dotenv": "^16.4.5",
    "openai": "^4.104.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.11"
  }
}
