// YeahDays — схема БД (Postgres на Railway).
// Пока без аутентификации: пользователь — анонимный device-id с клиента.
// Событие = сигнал движку (свайп/выполнение) → обучающая выборка +
// источник истории для серверных рекомендаций.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователь: анонимный (id = device-id, без email) ИЛИ с аккаунтом
// Google (email + Account). Anonymous-данные линкуются к аккаунту при входе.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  events        Event[]
  state         UserState?
  pushSubs      PushSubscription[]
  scheduled     ScheduledNotification[]
  assistantStatus AssistantStatus?
  assistantEvents AssistantEvent[]
  assistantChat   AssistantChat[]
  assistantFacts  AssistantFact[]
}

// Живой статус фонового процесса ДиДи: раз в ~15с шлёт heartbeat сюда,
// панель в профиле по свежести lastSeenAt решает online/offline. enabled —
// переключатель ИЗ браузера: ДиДи вычитывает его при каждом heartbeat и
// молчит на кодовое слово, если выключен. Один процесс на пользователя,
// поэтому одна строка, не лог.
model AssistantStatus {
  userId     String    @id
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime?
  enabled    Boolean   @default(true)
  updatedAt  DateTime  @updatedAt
}

// Лента того, что ДиДи услышала/сделала/ответила — для панели в профиле.
// Не путать с ScheduledNotification (та — про push, эта — про голосового
// помощника). Храним ограниченное число записей на пользователя (обрезка
// при вставке), это журнал для UI, а не аудит на годы.
model AssistantEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// heard | reply | tool | error
  kind      String
  text      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Текстовая переписка со страницы /didi. Браузер и процесс ДиДи не
// соединяются друг с другом напрямую (та же причина, что у AssistantStatus:
// HTTPS-страница не достучится до локального HTTP-процесса) — оба пишут и
// читают через эту таблицу на сервере. role="user" пишет браузер
// (/api/assistant/chat, сессия), role="assistant" пишет ДиДи
// (/api/assistant/chat/reply, ASSISTANT_SECRET). pulledAt — когда ДиДи
// забрала сообщение в обработку; NULL — ещё в очереди.
model AssistantChat {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// user | assistant
  role      String
  content   String
  pulledAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, role, pulledAt])
}

// Долговременная память ДиДи о пользователе — то, что он попросил
// запомнить ("Джарвис, запомни ..."), а не контекст одного разговора
// (тот живёт только в истории чата и пропадает с процессом/окном памяти).
// Пишется командой напрямую, без GPT (см. quickCommands.ts) — дёшево и
// предсказуемо. Читается при старте каждого нового разговора и
// подмешивается в историю, чтобы ДиДи знала это без явного вопроса.
model AssistantFact {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Подписка устройства на web-push. У одного пользователя может быть
// несколько (телефон + ноутбук) — шлём на все живые.
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// endpoint браузера — уникальный ключ подписки
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// сдвиг часового пояса клиента в минутах (getTimezoneOffset)
  tzOffset  Int      @default(0)
  /// час утреннего напоминания по локальному времени пользователя
  morningHour Int    @default(9)
  /// час вечернего напоминания
  eveningHour Int    @default(20)
  /// выключено пользователем, но подписку не удаляем
  enabled   Boolean  @default(true)
  /// когда последний раз успешно доставили — чтобы не слать дубли за день
  lastSentAt DateTime?
  /// какой тип последним отправляли (morning|evening)
  lastKind  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([enabled])
}

// Уведомление, поставленное на конкретное время: «время задачи вышло»,
// «через 5 минут созвон». Существует потому, что не все браузеры умеют
// планировать уведомления сами (Notification Triggers есть только в
// Chrome/Android). Там, где не умеют, момент показа держит сервер.
//
// key — идемпотентность: расписание пересобирается на каждое изменение
// плана, и без него на одну задачу накапливались бы десятки строк.
model ScheduledNotification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// ключ вида task:<id>:end или todo:<id>:<дата>
  key       String
  /// когда показать
  fireAt    DateTime
  title     String
  body      String
  /// куда вести по нажатию
  url       String    @default("/app")
  /// task | todo | day — для настроек и аналитики
  kind      String    @default("task")
  /// задача плана, если уведомление про неё (кнопка «Сделал»)
  taskId    String?
  /// проставляется после успешной отправки — второй раз не шлём
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, key])
  @@index([fireAt, sentAt])
  @@index([userId])
}

// Снимок клиентского состояния (план/цели/настроение/история) для
// кросс-девайс синхронизации. Одна строка на пользователя. Разрешение
// конфликтов — last-write-wins по clientAt (время изменения на клиенте).
model UserState {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// весь persist-слой Zustand как есть (включая updatedAt)
  data      Json
  /// время последнего изменения на клиенте (мс → Date) — для LWW
  clientAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Модели Auth.js (Prisma adapter) ──
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum EventType {
  accept
  reject
  complete
  skip
}

model Event {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  actionId  String
  type      EventType
  /// категория действия на момент события (для агрегатов без обращения к пулу)
  category  String?
  /// начисленный XP (для complete)
  xp        Int?
  at        DateTime  @default(now())
  createdAt DateTime  @default(now())

  @@index([userId, at])
  @@index([userId, actionId])
  @@index([userId, type])
}
