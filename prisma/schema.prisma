// YeahDays — схема БД (Postgres на Railway).
// Пока без аутентификации: пользователь — анонимный device-id с клиента.
// Событие = сигнал движку (свайп/выполнение) → обучающая выборка +
// источник истории для серверных рекомендаций.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователь: анонимный (id = device-id, без email) ИЛИ с аккаунтом
// Google (email + Account). Anonymous-данные линкуются к аккаунту при входе.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  events        Event[]
  state         UserState?
}

// Снимок клиентского состояния (план/цели/настроение/история) для
// кросс-девайс синхронизации. Одна строка на пользователя. Разрешение
// конфликтов — last-write-wins по clientAt (время изменения на клиенте).
model UserState {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// весь persist-слой Zustand как есть (включая updatedAt)
  data      Json
  /// время последнего изменения на клиенте (мс → Date) — для LWW
  clientAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Модели Auth.js (Prisma adapter) ──
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum EventType {
  accept
  reject
  complete
  skip
}

model Event {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  actionId  String
  type      EventType
  /// категория действия на момент события (для агрегатов без обращения к пулу)
  category  String?
  /// начисленный XP (для complete)
  xp        Int?
  at        DateTime  @default(now())
  createdAt DateTime  @default(now())

  @@index([userId, at])
  @@index([userId, actionId])
  @@index([userId, type])
}
