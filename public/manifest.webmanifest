{
  "id": "/app",
  "name": "YeahGrind \u2014 Make learning a practice",
  "short_name": "YeahGrind",
  "description": "Personal study plans, focused practice, course events and visible progress.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#f6f8fc",
  "theme_color": "#f6f8fc",
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icon-192-v4.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-v4.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512-v4.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Study plan",
      "short_name": "Study plan",
      "description": "Continue your next exercise",
      "url": "/learn?source=shortcut"
    },
    {
      "name": "Events",
      "short_name": "Events",
      "description": "Open course notes and revision",
      "url": "/events?source=shortcut"
    },
    {
      "name": "Progress",
      "short_name": "Progress",
      "description": "Review completed tasks and reflections",
      "url": "/progress?source=shortcut"
    }
  ]
}
